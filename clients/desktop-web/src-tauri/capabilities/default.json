{
  "$schema": "https://schema.tauri.app/schema/2/capabilities.json",
  "identifier": "default",
  "description": "Minimal capability set for the MSC 2 client shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-cursor-position",
    "core:window:allow-set-cursor-visible",
    "dialog:default",
    "fs:default",
    "fs:read-files",
    "notification:default"
  ]
}
