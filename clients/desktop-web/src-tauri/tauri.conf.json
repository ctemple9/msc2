{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MSC 2",
  "version": "0.1.23",
  "identifier": "com.ctemple.msc2",
  "build": {
    "beforeDevCommand": "npm run build && npm run prepare:agent && npm run dev",
    "beforeBuildCommand": "npm run build && npm run prepare:agent:release",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MSC 2",
        "width": 1600,
        "height": 900,
        "minWidth": 320,
        "minHeight": 480,
        "backgroundColor": "#000000",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://api.geysermc.org; img-src 'self' data: blob: https://mc-heads.net https://api.mcheads.org https://minotar.net; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "ctemple",
    "homepage": "https://github.com/ctemple9/msc2",
    "targets": "all",
    "icon": [
      "icons/icon-16x16.png",
      "icons/icon-32x32.png",
      "icons/icon-64x64.png",
      "icons/icon-128x128.png",
      "icons/icon-256x256.png",
      "icons/icon-512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "target/package/agent": "agent"
    },
    "linux": {
      "deb": {
        "preInstallScript": "../../../packaging/linux/desktop-cli-preinstall.sh",
        "postInstallScript": "../../../packaging/linux/desktop-cli-postinstall.sh",
        "postRemoveScript": "../../../packaging/linux/desktop-cli-postremove.sh"
      },
      "rpm": {
        "preInstallScript": "../../../packaging/linux/desktop-cli-preinstall.sh",
        "postInstallScript": "../../../packaging/linux/desktop-cli-postinstall.sh",
        "postRemoveScript": "../../../packaging/linux/desktop-cli-postremove.sh"
      }
    },
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "816be706-5775-5a3a-917c-339fbf0976e9",
        "template": "../../../packaging/windows/desktop-installer.wxs",
        "fragmentPaths": [
          "../../../packaging/windows/desktop-cli-path.wxs",
          "../../../packaging/windows/desktop-service-lifecycle.wxs",
          "../../../packaging/windows/desktop-installer-ui.wxs"
        ],
        "language": {
          "en-US": {
            "localePath": "../../../packaging/windows/desktop-installer-en-us.wxl"
          }
        },
        "componentRefs": ["MscCliPath"]
      }
    }
  }
}
