{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MSC 2",
  "version": "0.1.0",
  "identifier": "com.ctemple.msc2",
  "build": {
    "beforeDevCommand": "npm run prepare:agent && npm run dev",
    "beforeBuildCommand": "npm run prepare:agent && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MSC 2",
        "width": 1100,
        "height": 760,
        "minWidth": 320,
        "minHeight": 480,
        "backgroundColor": "#000000",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://api.geysermc.org; img-src 'self' data: blob: https://mc-heads.net https://api.mcheads.org https://minotar.net; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-16x16.png",
      "icons/icon-32x32.png",
      "icons/icon-64x64.png",
      "icons/icon-128x128.png",
      "icons/icon-256x256.png",
      "icons/icon-512x512.png",
      "icons/icon.png"
    ],
    "resources": {
      "target/package/agent": "agent"
    }
  }
}
