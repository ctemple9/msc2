    "/components/update": {
      "post": {
        "summary": "Update a system component (paper/geyser/floodgate) or a Modrinth-tracked add-on",
        "x-notes": "Three request shapes share one endpoint (RemoteAPIServer+ComponentRoutes.swift handleUpdateComponent): updateAll=true updates every add-on with an available update; jarStem updates one specific add-on; the legacy path (component=paper|geyser|floodgate) updates a system component. The two add-on paths return AddonUpdateResultDTO; the legacy path returns ComponentUpdateResultDTO.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComponentUpdateRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updateAll/jarStem paths return AddonUpdateResultDTO; the legacy component path returns ComponentUpdateResultDTO",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AddonUpdateResultDTO"
                    },
                    {
                      "$ref": "#/components/schemas/ComponentUpdateResultDTO"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "missing_body / invalid_json / missing_component_or_jar_stem / unknown_component",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found (jarStem path)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "not_supported (jarStem path)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
