{
  "openapi": "3.0.3",
  "info": {
    "title": "MSC 1 Remote API (compatibility baseline)",
    "version": "baseline",
    "description": "Captured from MSC 1's actual RemoteAPIServer*.swift source per msc2-decisions.md #145: behavior as MSC 1 has it, not aspirational. Built incrementally, one route family per P0.23a-P0.23s step (docs/msc2/rolling-plan.md)."
  },
  "paths": {
    "/servers/create": {
      "post": {
        "summary": "Create a new server",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServerCreateRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerCreateResultDTO"
                }
              }
            }
          },
          "400": {
            "description": "missing_body / invalid_json / name_required / invalid_server_type / invalid_java_flavor / unsupported_server_type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "create_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-notes": "Read from RemoteAPIServer+ComponentRoutes.swift handleCreateServer and RemoteAPIServer+HTTP.swift's serverMutationStatus. success/message/serverId/serverName/warnings come back on 200 even though the handler ultimately runs async via createServerProvider."
      }
    },
    "/servers/import": {
      "post": {
        "summary": "Scan or import an existing server directory/zip/transfer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServerImportRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "action=scan returns ServerImportScanResponseDTO; any other action (importExisting/importTransfer) returns ServerImportResultDTO \u2014 same status code, different body shape, dispatched on the request's own 'action' field.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ServerImportScanResponseDTO"
                    },
                    {
                      "$ref": "#/components/schemas/ServerImportResultDTO"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "missing_body / invalid_json / invalid_action / missing_source_path / invalid_path / display_name_required / backup_path_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "source_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "server_running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-notes": "Read from RemoteAPIServer+ComponentRoutes.swift handleImportServer and importStatus. req.action == \"scan\" routes to serverImportScanProvider; anything else routes to serverImportProvider."
      }
    },
