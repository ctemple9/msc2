            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupConfigUpdateResultDTO"
                }
              }
            }
          },
          "400": {
            "description": "missing_body / invalid_json / no_changes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "update rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-notes": "At least one of autoBackupEnabled/autoBackupIntervalMinutes/autoBackupMaxCount must be present, or the server rejects with no_changes (400)."
      }
    }
