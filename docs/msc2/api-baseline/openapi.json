        "responses": {
          "200": {
            "description": "EULA accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerEULAResultDTO"
                }
              }
            }
          },
          "400": {
            "description": "missing_body / invalid_json / missing_server_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "server_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "eula_write_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-notes": "ServerEULARequestDTO.serverId is itself Optional in the Swift DTO, but handleAcceptServerEULA treats an absent/empty serverId as missing_server_id (400) \u2014 so it's required in practice even though the type allows nil."
      }
    },
