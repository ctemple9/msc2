{
  "domain": "addon-update-resolution",
  "case": "merge-discovered-links-preserves-user-linked-title-provenance-icon",
  "source": {
    "file": "AppViewModel+AddonUpdates.swift",
    "test": "mergeDiscoveredLinks(_:into:) userLinked branch",
    "line": 62
