      "installedFileName": "new.jar",
      "installedHash": "newhash",
      "clientSide": "required",
      "serverSide": "required"
    }
  },
  "expected": {
    "merged_link": {
      "title": "My Custom Title",
      "provenance": "userLinked",
      "slug": "my-slug",
      "installedVersionId": "v2",
      "installedFileName": "new.jar",
      "installedHash": "newhash",
      "clientSide": "required",
      "serverSide": "required"
    },
    "reason": "Lines 60-70: when the prior persisted link's provenance is `.userLinked`, the merge keeps `title`/`slug`/`provenance`/base `iconURL` from the PRIOR entry untouched, and only overwrites `installedVersionId`/`installedFileName`/`installedHash`/`clientSide`/`serverSide` from the freshly discovered link -- a user's manual project choice is never silently retitled by a later hash-detect pass, but the installed-file bookkeeping still stays current."
