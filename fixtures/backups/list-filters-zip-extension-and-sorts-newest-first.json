  "input": {
    "directory_contents": [
      { "name": "world_auto_20260101-000000.zip", "modification_date": "2026-01-01T00:00:00Z" },
      { "name": "world_manual_20260103-000000.zip", "modification_date": "2026-01-03T00:00:00Z" },
      { "name": "world_manual_20260103-000000.meta.json", "modification_date": "2026-01-03T00:00:00Z" },
      { "name": "notes.txt", "modification_date": "2026-01-02T00:00:00Z" }
    ]
  },
  "expected": {
    "backup_items_in_order": [
      "world_manual_20260103-000000.zip",
      "world_auto_20260101-000000.zip"
