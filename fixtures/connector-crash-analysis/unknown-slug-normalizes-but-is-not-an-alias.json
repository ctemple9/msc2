      },
      {
        "call": "isKnownAlias",
        "slug": "fabric_api",
        "forgeFamily": true
      },
      {
        "call": "isKnownAlias",
        "slug": "fabric_api",
        "forgeFamily": false
      }
    ]
  },
  "expected": {
    "results": [
      "some-random-mod",
      false,
      true,
      true,
      false
