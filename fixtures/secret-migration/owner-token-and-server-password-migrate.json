{
  "domain": "secret-migration",
  "case": "owner-token-and-server-password-migrate",
  "source": {
    "file": "ConfigManager.swift",
    "test": "ConfigManager.init — remote_api_token + xbox_broadcast_alt_password migration",
    "line": 77
  },
  "input": {
    "config": {
      "config_version": 1,
      "servers_root": "/Users/test/MinecraftServers",
      "remote_api_token": "legacy-owner-token-9f8e7d6c5b4a",
      "servers": [
        {
          "id": "11111111-1111-1111-1111-111111111111",
          "display_name": "Survival",
          "xbox_broadcast_alt_password": "alt-account-pw-123"
        }
      ]
    }
  },
  "expected": {
    "config": {
      "config_version": 1,
      "servers_root": "/Users/test/MinecraftServers",
      "servers": [
        {
          "id": "11111111-1111-1111-1111-111111111111",
          "display_name": "Survival"
        }
      ]
    },
    "secretWrites": [
      { "key": "remote-api.owner-token", "value": "legacy-owner-token-9f8e7d6c5b4a" },
      { "key": "xbox-broadcast.alt-password.11111111-1111-1111-1111-111111111111", "value": "alt-account-pw-123" }
    ]
  },
  "notes": "Happy path: both legacy plaintext keys present and non-blank. Both migrate to SecretStore under the keys docs/msc2/substrate/secret-storage.md §9 already reserves, and both are stripped from the rewritten config regardless of the fact that they migrated -- matching ConfigManager.init lines 77-99, where the JSON decode (not this migration step itself) is what ultimately drops them since AppConfig's CodingKeys never included either field."
}
