{
  "serviceName": "com.ctemple.msc2.agent",
  "managementBind": "127.0.0.1:48001",
  "identity": "installing-user",
  "package": {
    "agentResourceSource": "clients/desktop-web/src-tauri/target/package/agent",
    "agentResourceTarget": "agent",
    "bedrockRuntimeArchive": "verified-first-run-download",
    "bedrockRuntimeBundled": false
  },
  "platforms": {
    "macos": {
      "manager": "launchd LaunchDaemon",
      "agentPath": "MSC 2.app/Contents/Resources/agent/msc",
      "worldMapRendererPath": "MSC 2.app/Contents/Resources/agent/vantage",
      "sidecarPath": "MSC 2.app/Contents/Resources/agent/sidecar",
      "headlessAgentPath": "agent/msc",
      "headlessWorldMapRendererPath": "agent/vantage",
      "headlessSidecarPath": "agent/sidecar",
      "bedrock": {
        "backend": "intel-vm-sidecar",
        "sidecarExecutable": "MSC 2.app/Contents/Resources/agent/sidecar/BedrockSidecar",
        "applianceArchitecture": "x86_64",
        "applianceResources": [
          "MSC 2.app/Contents/Resources/agent/sidecar/vmlinuz-kata",
          "MSC 2.app/Contents/Resources/agent/sidecar/appliance-initramfs.gz"
        ],
        "applianceBuildInput": "MSC2_BEDROCK_APPLIANCE_DIR",
        "runtimeArchive": "verified-first-run-download",
        "runtimeBundled": false
      },
      "appleSilicon": {
        "agentPath": "MSC 2.app/Contents/Resources/agent/msc",
        "sidecarPath": null,
        "bedrock": {
          "backend": "unavailable",
          "reason": "The Bedrock VM requires an Intel Mac",
          "runtimeArchive": "not-applicable",
          "runtimeBundled": false
        }
      },
      "dataPath": "~/Library/Application Support/MSC 2"
    },
    "windows": {
      "manager": "Windows Service",
      "agentPath": "agent/msc.exe",
      "worldMapRendererPath": "agent/vantage.exe",
      "sidecarPath": null,
      "bedrock": {
        "backend": "native",
        "executable": "server-directory/bedrock_server.exe",
        "runtimeArchive": "verified-first-run-download",
        "runtimeBundled": false
      },
      "dataPath": "%USERPROFILE%\\AppData\\Roaming\\MSC2"
    },
    "linux": {
      "manager": "systemd",
      "desktopServiceHelper": "desktop-service-helper",
      "serviceElevation": "pkexec (polkit)",
      "serviceOwnership": "root-owned unit; installing-user process and data",
      "credentialHelperService": "msc2-credential-helper.service",
      "credentialHelperSocket": "/run/msc2/credential-helper.sock",
      "credentialStorePath": "/var/lib/msc2/credentials",
      "agentPath": "../lib/MSC 2/agent/msc",
      "worldMapRendererPath": "../lib/MSC 2/agent/vantage",
      "developmentAgentPath": "../lib/MSC 2/agent/dev-builds/<sha256>/msc",
      "developmentAgentSource": "~/.local/share/msc2/agent/builds/<sha256>/msc",
      "sidecarPath": null,
      "bedrock": {
        "backend": "native",
        "executable": "server-directory/bedrock_server",
        "runtimeArchive": "verified-first-run-download",
        "runtimeBundled": false
      },
      "dataPath": "~/.local/share/msc2"
    }
  }
}
