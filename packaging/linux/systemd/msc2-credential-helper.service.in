[Unit]
Description=MSC 2 credential helper
Requires=msc2-credential-helper.socket
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/msc2/msc credential-helper serve --allowed-uid @MSC2_UID@ --store-dir /var/lib/msc2/credentials
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/msc2/credentials
RestrictAddressFamilies=AF_UNIX
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target
