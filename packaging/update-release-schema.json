{
  "schemaVersion": 1,
  "releaseSet": "msc-application",
  "releasePublicKeyBuildSetting": "MSC2_RELEASE_PUBLIC_KEY_HEX",
  "manifestSignature": {
    "algorithm": "Ed25519",
    "signedBytes": "canonical UTF-8 JSON manifest",
    "encoding": "detached base64 signature",
    "privateKeySource": "GitHub Actions secret only"
  },
  "manifestFiles": {
    "manifest": "msc2-update-manifest.json",
    "signature": "msc2-update-manifest.sig"
  },
  "manifestFields": {
    "required": [
      "schemaVersion",
      "releaseId",
      "tag",
      "api",
      "platforms"
    ],
    "api": {
      "required": ["major", "minMinor", "maxMinor"],
      "minorRange": "inclusive"
    },
    "platformEntry": {
      "required": ["target", "installMode", "assets"]
    },
    "asset": {
      "required": ["role", "filename", "bytes", "sha256"],
      "filename": "exact GitHub release asset filename",
      "sha256": "64 lowercase hexadecimal characters",
      "role": "desktop, archive, package-deb, or package-rpm"
    }
  },
  "platforms": {
    "macos-desktop-x86_64": {
      "target": "x86_64-apple-darwin",
      "installMode": "tauri-coordinated",
      "requiredArtifacts": ["desktop"],
      "includedComponents": ["agent", "sidecar"],
      "forbiddenArtifacts": []
    },
    "macos-headless-x86_64": {
      "target": "x86_64-apple-darwin",
      "installMode": "standalone-archive",
      "requiredArtifacts": ["archive"],
      "includedComponents": ["agent", "sidecar"],
      "forbiddenArtifacts": []
    },
    "macos-desktop-aarch64": {
      "target": "aarch64-apple-darwin",
      "installMode": "tauri-coordinated",
      "requiredArtifacts": ["desktop"],
      "includedComponents": ["agent"],
      "forbiddenArtifacts": ["sidecar"]
    },
    "macos-headless-aarch64": {
      "target": "aarch64-apple-darwin",
      "installMode": "standalone-archive",
      "requiredArtifacts": ["archive"],
      "includedComponents": ["agent"],
      "forbiddenArtifacts": ["sidecar"]
    },
    "windows-desktop-x86_64": {
      "target": "x86_64-pc-windows-msvc",
      "installMode": "tauri-coordinated",
      "requiredArtifacts": ["desktop"],
      "includedComponents": ["agent"],
      "forbiddenArtifacts": ["sidecar"]
    },
    "windows-headless-x86_64": {
      "target": "x86_64-pc-windows-msvc",
      "installMode": "standalone-archive",
      "requiredArtifacts": ["archive"],
      "includedComponents": ["agent"],
      "forbiddenArtifacts": ["sidecar"]
    },
    "linux-desktop-deb-x86_64": {
      "target": "x86_64-unknown-linux-gnu",
      "installMode": "authorized-package-install",
      "requiredArtifacts": ["package-deb"],
      "forbiddenArtifacts": ["sidecar"]
    },
    "linux-desktop-rpm-x86_64": {
      "target": "x86_64-unknown-linux-gnu",
      "installMode": "authorized-package-install",
      "requiredArtifacts": ["package-rpm"],
      "forbiddenArtifacts": ["sidecar"]
    },
    "linux-headless-x86_64": {
      "target": "x86_64-unknown-linux-gnu",
      "installMode": "standalone-archive",
      "requiredArtifacts": ["archive"],
      "includedComponents": ["agent"],
      "forbiddenArtifacts": ["sidecar"]
    }
  },
  "downloadLimits": {
    "manifestBytes": 262144,
    "signatureBytes": 4096,
    "releaseNotesBytes": 262144,
    "assetBytes": 2147483648,
    "totalBytes": 4294967296
  },
  "githubTransport": {
    "metadata": "discovery-only",
    "assetUrls": "derived from configured repository, releaseId, and signed filenames",
    "httpsRequired": true,
    "redirects": "configured GitHub repository only"
  },
  "installation": {
    "confirmation": "explicit and repeated for the staged releaseId",
    "staging": "local agent data updates/<releaseId>",
    "rollback": "restore previous release after failed replacement or health check",
    "remoteServiceControl": "forbidden"
  },
  "linux": {
    "tauriDesktop": "authorized .deb/.rpm package installation",
    "headlessArchive": "local verified replacement after CLI authorization",
    "distributionManaged": "package manager owns installation; MSC reports guidance only"
  },
  "preservedData": [
    "configuration",
    "secrets",
    "worlds",
    "server-files"
  ],
  "excludedUpdateFamilies": [
    "minecraft-server",
    "loader",
    "component",
    "add-on",
    "modpack",
    "plugin"
  ]
}
