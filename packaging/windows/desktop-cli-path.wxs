<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MscCliPath" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\CTemple\MSC2" Name="DesktopCliPath" Type="string" Value="[INSTALLDIR]agent" KeyPath="yes" />
        <Environment Id="MscCliPathEntry" Name="PATH" Value="[INSTALLDIR]agent" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
    </DirectoryRef>
    <CustomAction Id="MscRemoveIndicatorStartup" FileKey="Path" ExeCommand="--unregister-agent-indicator" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="MscRemoveIndicatorStartup" Before="InstallValidate">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
